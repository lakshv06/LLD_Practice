    {
      "id": "pPWXYc5GBqGeOk477FIMv",
      "type": "text",
      "x": 95.20274432209874,
      "y": -236.1790227681687,
      "width": 1500.6904100992592,
      "height": 326.42643912747906,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "strokeSharpness": "round",
      "seed": 1996810245,
      "version": 932,
      "versionNonce": 202508939,
      "isDeleted": false,
      "boundElementIds": null,
      "text": "Requirements-\n1. Two Player game\n2. Board size n*m - for now 3*3\n3. Move rules-\n    a. Player can only play in valid squares\n    b. Square is valid if it is not out of bounds (error condition) and empty\n    c. Player can not edit in previously filled squares\n    d. Players play in alternating chances\n4. Winning rules- A player wins if the player is able to completely fill any row/col/digonal with there move",
      "fontSize": 29.01568347799813,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "index": "aE",
      "frameId": null,
      "roundness": {
        "type": 2
      },
      "boundElements": [],
      "updated": 1753256921857,
      "link": null,
      "locked": false,
      "containerId": null,
      "originalText": "Requirements-\n1. Two Player game\n2. Board size n*m - for now 3*3\n3. Move rules-\n    a. Player can only play in valid squares\n    b. Square is valid if it is not out of bounds (error condition) and empty\n    c. Player can not edit in previously filled squares\n    d. Players play in alternating chances\n4. Winning rules- A player wins if the player is able to completely fill any row/col/digonal with there move",
